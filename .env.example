# ===== RENDER BACKEND ENVIRONMENT VARIABLES =====
# Set these in your Render dashboard: Dashboard > Your Service > Environment

GROQ_API_KEY=your_groq_api_key_here

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# This MUST point to YOUR Render backend's /api/auth/google/callback
# Example: https://eduverseai-gpmf.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://YOUR-RENDER-APP.onrender.com/api/auth/google/callback

# Your Vercel frontend URL (where users land after login)
FRONTEND_URL=https://YOUR-VERCEL-APP.vercel.app
